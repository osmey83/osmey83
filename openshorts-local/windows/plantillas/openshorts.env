# .env de OpenShorts generado por openshorts-local (plantilla del kit).
# OpenShorts lo lee con load_dotenv() desde la carpeta montada en /app.

# --- LLM local (moment picker + títulos/descripciones) ---------------------
# Instancia Ollama SOLO-CPU del kit (iniciar.ps1), no tu Ollama principal.
LLM_BASE_URL=http://host.docker.internal:{{OLLAMA_CPU_PORT}}/v1
LLM_MODEL={{LLM_MODEL}}
# En CPU un lote de puntuación puede tardar minutos.
LLM_TIMEOUT=900
LLM_SCORE_BATCH=3

# --- Transcripción en la RTX 5090 ---------------------------------------
WHISPER_MODEL={{WHISPER_MODEL}}
WHISPER_DEVICE={{WHISPER_DEVICE}}
WHISPER_COMPUTE={{WHISPER_COMPUTE}}
# whisper (todos los idiomas) | parakeet (~2x más rápido, 25 idiomas europeos,
# vuelve a whisper solo si falla). Español está entre los 25.
TRANSCRIBE_BACKEND=whisper
ASR_GPU_CONCURRENCY=1

# --- Codificación -----------------------------------------------------------
# auto = prueba h264_nvenc al arrancar y si falla usa libx264.
FFMPEG_ENCODER=auto

# --- Autoalojado detrás de tu propio equipo -----------------------------
RATE_LIMIT_ENABLED=0
# Aviso de calidad solo para fuentes URL (0 lo desactiva).
QUALITY_GATE_MIN_HEIGHT=720

# --- Opcionales (déjalos vacíos si no los usas) ---------------------------
# GEMINI_API_KEY=        # solo para el selector de layout por fotogramas y vídeos sin voz
# UPLOAD_POST_API_KEY=   # publicación en redes; el kit NUNCA publica sin aprobación
